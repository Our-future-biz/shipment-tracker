  etaCnee: string;
  etaCneeTime?: string;
  vessel: string;
  voyage?: string;
  goods: string;
  hsCode: string;
  booking?: string;
  myRef?: string;
  cntr?: string;
  crd?: string;
  pu?: string;
  closing?: string;
  destination?: string;
  extra?: Record<string, string>;
}

