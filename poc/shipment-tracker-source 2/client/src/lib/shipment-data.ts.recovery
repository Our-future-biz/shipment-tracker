// Maps shipment fields to full-sheet column positions
export function getColumnValue(s: Shipment, col: string): string {
  const map: Record<string, string | undefined> = {
    "Job number": s.jobNumber,
    "Job Month": s.month,
    "Department": s.dept,
    "Job handled by": s.handler,
    "Shipper": s.shipper,
    "Consignee": s.consignee,
    "Customs status": s.customsStatus,
    "Status": s.status,
    "Shipment type": s.shipmentType,
    "FCL/LCL": s.fclLcl,
    "Shipping line / Coloader": s.shippingLine,
    "POL": s.pol,
    "POD": s.pod,
    "ETD date": s.etd,
    "ETA date": s.eta,
    "ETA depo": s.etaDepo,
    "ETA cnee": s.etaCnee,
    "ETA cnee time": s.etaCneeTime,
    "Vessel": s.vessel,
    "Voyage": s.voyage,
    "Goods description": s.goods,
    "HS code": s.hsCode,
    "Booking number": s.booking,
    "My reference": s.myRef,
    "CNTR no.": s.cntr,
    "CRD date": s.crd,
    "PU date": s.pu,
    "Closing date": s.closing,
    "Destination": s.destination,
  };
  return map[col] ?? (s.extra?.[col] ?? "");
}

