# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=5000                     # Port the Express server listens on

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite file path (relative to project root). Default: customers.db
DATABASE_URL=./customers.db

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-secret-string

# ─── Supabase (optional – only if you migrate away from SQLite) ───────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── External APIs ────────────────────────────────────────────────────────────
# Czech Company Registry (ARES) – no key required, public REST API
# https://ares.gov.cz/ekonomicke-subjekty-v-be/rest/ekonomicke-subjekty/{ico}
